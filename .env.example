# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging
SANITY_API_WRITE_TOKEN=

# Review authorId (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# One-time: pnpm backfill:course-stats (after adding aggregate fields to courses)

# CAS (local mock via docker compose)
CAS_SERVER_URL=http://localhost:8080/cas
CAS_SERVICE_URL=http://localhost:3000/api/auth/cas/callback

# Session cookie signing (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Twilio (only if CAS_SERVER_URL is unset)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
